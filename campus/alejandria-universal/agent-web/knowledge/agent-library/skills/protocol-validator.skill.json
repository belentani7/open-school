{
  "id": "protocol-validator",
  "name": "protocol-validator",
  "description": "Valida contratos .proto / openapi / graphql contra implementaciones.",
  "inputs": [
    "protocols/*.proto",
    "protocols/openapi.yaml"
  ],
  "outputs": [
    "reports/contract-report.json"
  ],
  "capabilities": [
    "proto-lint",
    "openapi-validate",
    "breaking-change-detection"
  ]
}
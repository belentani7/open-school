{
  "https": {
    "name": "HTTPS/TLS 1.3",
    "transport": "TCP+TLS",
    "use": "Retrofit/OkHttp + NSC + pinning",
    "example": "GET https://api.example.com/v1/items"
  },
  "grpc": {
    "name": "gRPC/Protobuf",
    "transport": "HTTP/2",
    "use": "Contratos .proto streaming",
    "example": "rpc GetItem(GetItemRequest) returns (Item)"
  },
  "websocket": {
    "name": "WebSocket/SSE",
    "transport": "TCP",
    "use": "Tiempo real",
    "example": "ws://... / text/event-stream"
  },
  "ble": {
    "name": "BLE GATT",
    "transport": "Bluetooth Low Energy",
    "use": "Sensors/IoT",
    "example": "scan -> connect -> readCharacteristic"
  },
  "nfc": {
    "name": "NFC NDEF/HCE",
    "transport": "NFC",
    "use": "Tags y pagos",
    "example": "NDEF record TYPE_TEXT"
  },
  "mqtt": {
    "name": "MQTT",
    "transport": "TCP",
    "use": "IoT",
    "example": "publish topic=qos1"
  },
  "fcm": {
    "name": "FCM",
    "transport": "HTTPS",
    "use": "Push",
    "example": "POST https://fcm.googleapis.com/v1/projects/.../messages:send"
  }
}
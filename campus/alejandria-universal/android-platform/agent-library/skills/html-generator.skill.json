{
  "id": "html-generator",
  "name": "html-generator",
  "description": "Genera masivamente 200+ HTMLs HTML5 semánticos desde plantillas.",
  "inputs": [
    "manifest.json",
    "src/templates/*.html"
  ],
  "outputs": [
    "tracks/**/index.html",
    "modules/**/index.html",
    "lessons/**/*.html"
  ],
  "capabilities": [
    "mass-generation",
    "template-rendering",
    "asset-injection",
    "a11y-check"
  ],
  "tools": [
    "render_template",
    "inject_assets",
    "validate_html5"
  ],
  "scale": "216 HTMLs por ejecución, idempotente"
}
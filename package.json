{
  "name": "open-school",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Escuela digital gratuita: seis rutas, doce unidades evaluables, progreso local y tutor orientador",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",

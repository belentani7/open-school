    "build:biblia": "node client/scripts/build-biblia.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.2.1",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^24.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "typescript": "5.6.3",
    "vite": "7.3.7",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.4.1"
}

# Open School — variables de entorno
#
# El proyecto solo usa tres, y las tres son del backend de Python.
# El frontend (Vite/React) NO lee ninguna variable propia: no hay
# claves, tokens ni URLs del lado del cliente. Si alguna vez añades
# una VITE_*, recuerda que lo que empieza por VITE_ queda embebido en
# el bundle publico: nunca pongas ahi un secreto.
#
# Copia este archivo a `.env` solo si necesitas tocar algo; `.env`
# esta en .gitignore y jamas se versiona.

# --- Backend (backend/app/main.py) ---
# Puerto del servidor WSGI. Vite reenvia /api al puerto 8001 por defecto.
PORT=8001
HOST=127.0.0.1

# --- Tutor local (backend/app/adapters/ollama_client.py) ---
# Ollama debe estar disponible en el backend. No se necesita API key.
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2:3b

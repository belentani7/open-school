ion and Event Management","significado":"Gestión de información y eventos de seguridad."},{"abrev":"SOAR","curso":"secure-t","nombre":"Security Orchestration, Automation and Response","significado":"Orquestación, automatización y respuesta de seguridad."}]},{"id":"INFRAESTRUCTURA","glosa":"La parte que no es código pero de la que depende todo: contenedores, redes, despliegue.","glifo":"⬢","terminos":[{"abrev":"IaC","curso":"manos-abiertas","nombre":"Infrastructure as Code","significado":"Infraestructura como código."},{"abrev":"Docker","curso":"manos-abiertas","nombre":"Docker","significado":"Plataforma de contenedores."},{"abrev":"Kubernetes (K8s)","nombre":"Kubernetes","significado":"Orquestador de contenedores."},{"abrev":"Terraform","curso":"manos-abiertas","nombre":"Terraform","significado":"Infraestructura como código."},{"abrev":"Ansible","nombre":"Ansible","significado":"Automatización de configuración."},{"abrev":"Pulumi","nombre":"Pulumi","significado":"Infraestructura como código."},{"abrev":"Helm","nombre":"Helm","significado":"Gestor de paquetes para Kubernetes."},{"abrev":"Istio","nombre":"Istio","significado":"Service mesh."},{"abrev":"Consul","nombre":"Consul","significado":"Service mesh y descubrimiento de servicios."},{"abrev":"EKS","nombre":"Elastic Kubernetes Service","significado":"Servicio de Kubernetes de AWS."},{"abrev":"AKS","nombre":"Azure Kubernetes Service","significado":"Servicio de Kubernetes de Azure."},{"abrev":"GKE","nombre":"Google Kubernetes Engine","significado":"Motor de Kubernetes de Google."},{"abrev":"Fargate","nombre":"Fargate","significado":"Computación sin servidores para contenedores de AWS."},{"abrev":"Lambda","nombre":"Lambda","significado":"Computación sin servidores de AWS."},{"abrev":"PaaS","nombre":"Platform as a Service","significado":"Plataforma como servicio."},{"abrev":"IaaS","nombre":"Infrastructure as a Service","significado":"Infraestructura como servicio."},{"abrev":"SaaS","nombre":"Software as a Service","si
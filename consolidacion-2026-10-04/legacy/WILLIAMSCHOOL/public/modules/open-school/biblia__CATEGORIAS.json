icial."},{"abrev":"DataOps","nombre":"Data Operations","significado":"Operaciones de datos."},{"abrev":"GitOps","nombre":"GitOps","significado":"GitOps."},{"abrev":"SRE","curso":"agent-systems","nombre":"Site Reliability Engineering","significado":"Ingeniería de fiabilidad del sitio."}]},{"id":"TÉRMINOS DE CÓDIGO","glosa":"El día a día: el editor, el control de versiones y los principios que guían decisiones.","glifo":"◐","terminos":[{"abrev":"IDE","nombre":"Integrated Development Environment","significado":"Entorno de desarrollo integrado."},{"abrev":"VCS","nombre":"Version Control System","significado":"Sistema de control de versiones."},{"abrev":"Git","nombre":"Git","significado":"Sistema de control de versiones distribuido."},{"abrev":"GitHub","nombre":"GitHub","significado":"Plataforma de hosting de código."},{"abrev":"GitLab","nombre":"GitLab","significado":"Plataforma de DevOps."},{"abrev":"Bitbucket","nombre":"Bitbucket","significado":"Plataforma de hosting de código."},{"abrev":"LFS","nombre":"Large File Storage","significado":"Almacenamiento de archivos grandes."},{"abrev":"Monorepo","nombre":"Monorepo","significado":"Repositorio único para múltiples proyectos."},{"abrev":"Branch","nombre":"Branch","significado":"Rama."},{"abrev":"Commit","nombre":"Commit","significado":"Conjunto de cambios con mensaje."},{"abrev":"Push","nombre":"Push","significado":"Subir cambios al repositorio remoto."},{"abrev":"Pull","nombre":"Pull","significado":"Bajar cambios del repositorio remoto."},{"abrev":"Merge","nombre":"Merge","significado":"Fusionar ramas."},{"abrev":"Rebase","nombre":"Rebase","significado":"Reaplicar commits sobre otra base."},{"abrev":"Cherry-pick","nombre":"Cherry-pick","significado":"Aplicar un commit específico."},{"abrev":"Stash","nombre":"Stash","significado":"Guardar cambios temporalmente."},{"abrev":"Clone","nombre":"Clone","significado":"Copiar un repositorio."},{"abrev":"Fork","nombre":"Fork","significado":"Copiar un repositorio a tu cuenta."},{"
re":"C4 Model","significado":"Notación para arquitectura de software."}]},{"id":"ARQUITECTURA","glosa":"Los estilos de organizar un sistema. Elegir arquitectura es decidir qué duele cambiar más adelante.","glifo":"▦","terminos":[{"abrev":"MVC","nombre":"Model-View-Controller","significado":"Modelo-Vista-Controlador."},{"abrev":"MVVM","nombre":"Model-View-ViewModel","significado":"Modelo-Vista-ViewModel."},{"abrev":"MVP","nombre":"Model-View-Presenter","significado":"Modelo-Vista-Presentador."},{"abrev":"MVI","nombre":"Model-View-Intent","significado":"Modelo-Vista-Intención."},{"abrev":"Clean Architecture","nombre":"Clean Architecture","significado":"Arquitectura limpia."},{"abrev":"Hexagonal Architecture","nombre":"Hexagonal Architecture","significado":"Arquitectura hexagonal."},{"abrev":"Microservices","nombre":"Microservices","significado":"Microservicios."},{"abrev":"SOA","nombre":"Service-Oriented Architecture","significado":"Arquitectura orientada a servicios."},{"abrev":"EDA","nombre":"Event-Driven Architecture","significado":"Arquitectura orientada a eventos."},{"abrev":"CQRS","nombre":"Command Query Responsibility Segregation","significado":"Segregación de comandos y consultas."},{"abrev":"Event Sourcing","nombre":"Event Sourcing","significado":"Fuente de eventos."}]},{"id":"TESTING","glosa":"Las capas de prueba y qué encuentra cada una. Probar no es lo mismo que comprobar.","glifo":"◎","terminos":[{"abrev":"Unit Test","curso":"secure-t","nombre":"Unit Test","significado":"Test unitario."},{"abrev":"Integration Test","curso":"secure-t","nombre":"Integration Test","significado":"Test de integración."},{"abrev":"E2E","curso":"secure-t","nombre":"End-to-End Test","significado":"Test de extremo a extremo."},{"abrev":"UAT","curso":"secure-t","nombre":"User Acceptance Testing","significado":"Pruebas de aceptación de usuario."},{"abrev":"SIT","curso":"secure-t","nombre":"System Integration Testing","significado":"Pruebas de integración del sistema."},{"abrev":"FAT
[{"id":"TÉRMINOS FUNDAMENTALES","glosa":"Los acrónimos que ordenan un proyecto de software. Si dos personas discuten y no comparten estas siglas, la discusión no es técnica: es de vocabulario.","glifo":"◆","terminos":[{"abrev":"PRD","nombre":"Product Requirements Document","significado":"Documento de requisitos del producto. Define QUÉ se va a construir y POR QUÉ."},{"abrev":"TRD","nombre":"Technical Requirements Document","significado":"Documento de requisitos técnicos. Define CÓMO se va a construir."},{"abrev":"SDD","nombre":"Software Design Document","significado":"Documento de diseño de software. Arquitectura detallada, módulos, interfaces."},{"abrev":"ADR","nombre":"Architecture Decision Record","significado":"Registro de decisiones de arquitectura. POR QUÉ cada decisión."},{"abrev":"BDD","nombre":"Behavior-Driven Development","significado":"Desarrollo guiado por comportamiento. Lenguaje natural (Gherkin)."},{"abrev":"TDD","curso":"secure-t","nombre":"Test-Driven Development","significado":"Desarrollo guiado por pruebas. Test antes que código."},{"abrev":"CI/CD","curso":"manos-abiertas","nombre":"Continuous Integration / Continuous Delivery","significado":"Integración continua / Entrega continua."},{"abrev":"MVP","nombre":"Minimum Viable Product","significado":"Producto mínimo viable."},{"abrev":"SLA","nombre":"Service Level Agreement","significado":"Acuerdo de nivel de servicio."},{"abrev":"API","curso":"agent-systems","nombre":"Application Programming Interface","significado":"Interfaz de programación de aplicaciones."},{"abrev":"App Flow","nombre":"Application Flow","significado":"Flujo de la aplicación."},{"abrev":"UI","curso":"ux-academy","nombre":"User Interface","significado":"Interfaz de usuario."},{"abrev":"UX","curso":"ux-academy","nombre":"User Experience","significado":"Experiencia de usuario."},{"abrev":"Design","curso":"ux-academy","nombre":"Design","significado":"Diseño."},{"abrev":"Schema","nombre":"Schema","significado":"Estructura de datos."},
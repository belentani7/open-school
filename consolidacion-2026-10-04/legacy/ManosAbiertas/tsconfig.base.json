{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@belentani/*": ["packages/*/src"],
      "@/*": ["./src"]
    },
    "types": ["node", "vite/client"]
  },
  "exclude": ["node_modules", "dist", ".turbo", "**/dist/**", "**/.next/**"]
}